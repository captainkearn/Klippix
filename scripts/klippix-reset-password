#!/bin/sh
set -eu

PASSWORD_FILE=/etc/klippix/initial-password
HTPASSWD_FILE=/etc/klippix/htpasswd
WEB_USER=klippix

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this command as root: sudo klippix-reset-password" >&2
    exit 1
fi

install -d -m 0750 -o root -g www-data /etc/klippix

if [ "${1:-}" = "--random" ]; then
    password="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"
    printf '%s\n' "$password" >"$PASSWORD_FILE"
    chmod 0600 "$PASSWORD_FILE"
    htpasswd -bcB "$HTPASSWD_FILE" "$WEB_USER" "$password" >/dev/null
    echo "Klippix web username: $WEB_USER"
    echo "Klippix web password: $password"
elif [ "$#" -eq 0 ] && [ -t 0 ]; then
    htpasswd -cB "$HTPASSWD_FILE" "$WEB_USER"
    rm -f "$PASSWORD_FILE"
else
    echo "Usage: klippix-reset-password [--random]" >&2
    exit 2
fi

chown root:www-data "$HTPASSWD_FILE"
chmod 0640 "$HTPASSWD_FILE"

nginx -t
if command -v systemctl >/dev/null 2>&1; then
    systemctl reload nginx
else
    service nginx reload
fi
